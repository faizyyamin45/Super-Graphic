Options -Indexes -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{HTTP_HOST} ^www\.supergraphic\.ae$ [NC]
  RewriteRule ^ https://supergraphic.ae%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Never serve configuration, source, dependency, or backup files.
  RewriteRule (^|/)\. - [F,L]
  RewriteRule ^(?:supergraphic-private|vendor|server|hostinger)(?:/|$) - [F,L,NC]
  RewriteRule \.(?:env|ini|log|sql|sqlite|bak|zip|tar|gz|phar)$ - [F,L,NC]
  RewriteRule ^(?:composer\.(?:json|lock)|package(?:-lock)?\.json)$ - [F,L,NC]

  # Run the PHP API before the React route fallback.
  RewriteRule ^api(?:/.*)?$ api/index.php [END,QSA]
  RewriteRule ^media-files(?:/.*)?$ api/index.php [END,QSA]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  <FilesMatch "\.(?:html|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
AddDefaultCharset UTF-8
