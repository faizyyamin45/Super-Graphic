# Copy to .env for local development. Never commit the real .env.
SITE_ORIGIN=http://127.0.0.1:5173
# Enable this only when running the media server as well as Vite.
VITE_MEDIA_BACKEND=server
PORT=3001
# Run npm run admin:password and paste the generated salt:hash here.
ADMIN_PASSWORD_HASH=
# Local default is .media-data. In production, set an absolute directory OUTSIDE
# the source checkout, public_html and build output. Confirm it survives redeploys.
MEDIA_DATA_DIR=
# Configure only after confirming the number of trusted reverse proxy hops.
TRUST_PROXY_HOPS=0

