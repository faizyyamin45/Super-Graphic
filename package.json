{
  "name": "super-graphic-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "prebuild": "node scripts/check-details.mjs",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "check": "node scripts/check-details.mjs",
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.js",
    "admin:password": "node scripts/admin-password.mjs",
    "test": "node --test server/*.test.js",
    "build:server": "vite build --mode server",
    "dev:client": "vite --host 127.0.0.1",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.34.0",
    "mongodb": "^7.6.0",
    "multer": "^2.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.2",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "vite": "^8.2.2"
  },
  "description": "Super Graphic Advertising LLC — Dubai signage",
  "engines": {
    "node": ">=24.0.0"
  }
}
